# Application
APP_NAME=AI Career Copilot
ENVIRONMENT=development
DEBUG=True

# Security & Authentication
SECRET_KEY=ai-career-copilot-production-grade-super-secret-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# Local development default: sqlite+aiosqlite:///./career_copilot.db
# Docker & Production default: postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/career_copilot_db
DATABASE_URL=sqlite+aiosqlite:///./career_copilot.db
POSTGRES_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword2026@localhost:5432/career_copilot_db

# AI Provider API Keys (Optional: deterministic semantic engine works out-of-the-box if omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=auto

# Redis Cache & Background Queue
REDIS_URL=redis://localhost:6379/0

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
